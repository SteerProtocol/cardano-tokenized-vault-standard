# Original node configuration, topology and genesis files. This directory is mounted read-only.
NODE_CONFIG_DIR=/absolute/path/to/network
# Validated configuration with reviewed program bytes and a real intersection, not the example placeholders.
INDEXER_CONFIG=/absolute/path/to/indexer.json
# Directory containing kupo.json with plugin registrations and the same genesis identity.
KUPO_CONFIG_DIR=/absolute/path/to/kupo-configuration
# Optional prebuilt Kupo startup image; no rebuild is needed to change registrations.
CTVS_KUPO_IMAGE=ctvs-kupo:local
INDEXER_PORT=18080
OGMIOS_PORT=18005
KUPO_PORT=18006
CTVS_STACK_NAME=ctvs-indexer-local
