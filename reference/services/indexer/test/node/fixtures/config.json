  "TestBabbageHardForkAtEpoch": 0,
  "TestConwayHardForkAtEpoch": 0,
  "DijkstraGenesisFile": "genesis/dijkstra-genesis.json",
  "PeerSharing": false,
  "MinBigLedgerPeersForTrustedState": 0
